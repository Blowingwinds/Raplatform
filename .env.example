# Raplatform LLM provider configuration
# 复制本文件为 .env，填入真实值（.env 已在 .gitignore 中，不会提交）
#
# 兼容 OpenAI Chat Completions 协议的服务均可直接使用：
#   DeepSeek    : https://api.deepseek.com/v1          模型 deepseek-chat
#   OpenAI      : https://api.openai.com/v1            模型 gpt-4o-mini / gpt-4o
#   通义千问     : https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   Moonshot    : https://api.moonshot.cn/v1           模型 moonshot-v1-8k
#   本地 Ollama : http://127.0.0.1:11434/v1            模型 qwen2.5:14b（key 随便填）
#
RAPLATFORM_LLM_BASE_URL=https://api.deepseek.com/v1
RAPLATFORM_LLM_API_KEY=sk-your-key-here
RAPLATFORM_LLM_MODEL=deepseek-chat

# 可选：请求超时（秒）与温度
RAPLATFORM_LLM_TIMEOUT=120
RAPLATFORM_LLM_TEMPERATURE=0.2